# Copy this file to  config/ca2.env  and edit.  All run_qN.sh scripts read it (it is optional).
# Every value below is the DEFAULT; remove the leading '#' only for values you want to change.

# Local copy of the issued dataset (folder that contains q1 ... q10 and README.txt)
#DATA_DIR="$HOME/ca2_data/CA2_Dataset"

# HDFS user and base directory (assignment: /user/<username>/ca2/qN/input)
#HDFS_USER="$USER"
#HDFS_BASE="/user/$HDFS_USER/ca2"

# Reduce tasks used by the jobs (assignment Q3 needs >= 3)
#REDUCERS=4

# 'mvn' (default; falls back to javac + hadoop classpath if Maven fails) | 'javac'
#BUILD_TOOL=mvn

# 1 = answer 'yes' to every confirmation question (same as --yes). Default 0: the scripts ASK before deleting HDFS output.
#ASSUME_YES=0

# 1 = stop at every screenshot point and wait for ENTER (same as --pause)
#PAUSE_FOR_SCREENSHOTS=0

# Web UIs printed for the screenshots
#RM_UI="http://localhost:8088"
#HISTORY_UI="http://localhost:19888"
#NN_UI="http://localhost:9870"

# ---- per question tuning (all optional) ----
# Q1: byte size used to force >= 3 input splits in the wrong-combiner experiment
#Q1_SPLIT_MAXSIZE=4000000
# Q2: phrase searched by Job 3
#Q2_PHRASE="big data analytics"
# Q4: reducer container memory used for the streaming proof (MB) and JVM heap
#Q4_REDUCE_MEMORY_MB=512
#Q4_REDUCE_HEAP_MB=384
